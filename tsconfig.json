{
  "include": [
    "./**/*",
  ],
  "compilerOptions": {
    "outDir": "dist",
    "strict": true,
    "alwaysStrict": true,
    "composite": true,
    "removeComments": true,
    "declarationDir": "dist/types",
    "noEmitOnError": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "strictBindCallApply": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "lib": [
      "ESNext",
      "DOM"
    ]
  }
}
