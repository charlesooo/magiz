{
  "name": "magiz",
  "version": "1.0.0-beta",
  "license": "GPL-3.0-or-later",
  "author": "周曦",
  "description": "a light weight building 3D model generator",
  "homepage": "https://www.architech.fun",
  "keywords": [
    "architecture",
    "cityPlanning"
  ],
  "main": "index.ts",
  "dependencies": {
    "math-expression-evaluator": "^2.0.5",
    "three": "^0.164.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "@types/three": "^0.164.0",
    "esbuild": "0.21.3"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "esbuild index.ts --format=esm --bundle --sourcemap --watch --outfile=dist/magiz.module.js",
    "build": "esbuild index.ts --format=esm --bundle --minify --metafile=dist/meta.min.json --outfile=dist/magiz.module.min.js && echo 包大小分析: https://www.esbuild.cn/api/#metafile",
    "course": "esbuild index.ts --format=esm --bundle --watch --minify --outfile=D:/Works/magiz-course/src/magiz.module.min.js",
    "demo_city": "esbuild index.ts --format=esm --bundle --watch --minify --outfile=demo/magiz.module.min.js"
  }
}
