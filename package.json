{
  "name": "magiz",
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "author": "周曦",
  "description": "a light weight 3D building generator",
  "homepage": "http://www.architech.fun",
  "keywords": [
    "architecture",
    "city planning",
    "urban design",
    "3D building",
    "three.js"
  ],
  "main": "index.ts",
  "devDependencies": {
    "@types/three": "^0.172.0",
    "esbuild": "^0.24.2"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "esbuild bundle/esbuild_magiz.ts --outfile=dist/magiz.module.min.js --external:three --format=esm --sourcemap --bundle --watch \n >>> dist/magiz.module.min.js",
    "build": "esbuild bundle/esbuild_magiz.ts --outfile=dist/magiz.module.min.js --external:three --format=esm --bundle --minify --analyze \n >>> dist/magiz.module.min.js",
    "dev_": "esbuild bundle/esbuild_magiz_and_view.ts --outfile=dist/magiz.view.module.min.js --format=esm --sourcemap  --bundle --watch \n >>> dist/magiz.view.module.min.js",
    "build_": "esbuild bundle/esbuild_magiz_and_view.ts --outfile=dist/magiz.view.module.min.js --metafile=dist/magiz.view.meta.json --format=esm --bundle --minify --analyze \n >>> dist/magiz.view.module.min.js"
  },
  "dependencies": {
    "math-expression-evaluator": "^2.0.6",
    "three": "^0.172.0"
  }
}
